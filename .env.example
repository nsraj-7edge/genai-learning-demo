# Copy this file to .env and fill in your values
# AWS Configuration — uses your local AWS CLI profile (no keys needed)
AWS_PROFILE=your-aws-profile-name
AWS_REGION=us-east-1

# AWS Bedrock Model IDs — cross-region inference profiles (us. prefix required)
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_MODEL_ID_FAST=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Server
PORT=3001
NODE_ENV=development
